# Trading settings. Edit on github.com, and the next run picks them up.
# API keys go in Settings > Secrets and variables > Actions, never here.

SYMBOL=BTC-USD
TRADE_USD=10
# Minimum 10. 12 = one trade every 2 hours.
TRADES_PER_DAY=12
TAKE_PROFIT_PCT=1.0
STOP_LOSS_PCT=1.5
MAX_DAILY_LOSS_USD=5

# true = simulate only. Change to false for real orders.
DRY_RUN=true
